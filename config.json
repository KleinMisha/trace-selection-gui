{ //Main Application panel
    "main": {
        "colors": {
            "unsaved_changes": "coral",
            "no_unsaved_changes": "white"
        },
        "keyboard_shortcuts": {
            "menu.file.open": "Ctrl+O",
            "menu.file.save": "Ctrl+S",
            "menu.file.save_as": "Ctrl+Shift+S",
            "next_trace": "Ctrl+Right",
            "previous_trace": "Ctrl+Left"
        },
        "default_file_paths": {
            "labels": "",
            "section_labels": ""
        }
    },
    // The Interactive Plot  
    "plot": {
        "min_time": 0.0,
        "max_time": 3600.0,
        "min_height": -1.0,
        "max_height": 1.0,
        "vertical_line_color": "skyblue",
        "data_line_color": "black"
    },
    // Label panel 
    "label_assignment": {
        "colors": {
            "assigned": "green",
            "unassigned": "white"
        },
        "keyboard_shortcuts": {
            "assign_label": "Ctrl++",
            "unassign_label": "Ctrl+-",
            "next_label": "Ctrl+Up",
            "previous_label": "Ctrl+Down"
        }
    },
    // Sections panel 
    "section_assignment": {
        "colors": {
            "assigned": "green",
            "unassigned": "white"
        },
        "keyboard_shortcuts": {
            "assign_label": "Alt++",
            "unassign_label": "Alt+-",
            "next_section": "Alt+Shift+Up",
            "previous_section": "Alt+Shift+Down",
            "next_label": "Alt+Up",
            "previous_label": "Alt+Down"
        }
    }
}