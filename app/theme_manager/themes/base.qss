/*
Template Qt Style Sheet defining the main elements that will change based on the selected color palette (see the JSON files). 
*/


/* ===== Base Application Background ===== */
QWidget {
    background-color: $background;       
    color: $text;                  
    font-size: 16px;
}

/* ===== Component Containers ===== */
QFrame {
    background-color: $surface;       
    border: 1px solid $primary;
    border-radius: 6px;
    padding: 4px;
}

/* ===== Labels ===== */
QLabel {
    color: $text;              
}

/* ===== Buttons ==== */
QPushButton {
    background-color: $primary;
    color: #FFFFFF; 
    border: 1px solid $primary;
    border-radius: 6px;
    padding: 6px 12px; 
 }

QPushButton:hover{
    background-color: $primary_variant;
}

QPushButton:pressed{
    background-color: $primary_variant;
}

/*==== Menu Bar ===== */ 
QMenuBar { 
    background-color: $primary;
    color: #FFFFFF;
    spacing: 4px; 
}

QMenuBar::item:selected {
    background-color: $primary_variant;
}

QMenuBar::item:pressed {
    background-color: $primary_variant;
}
